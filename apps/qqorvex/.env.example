VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TC008EeDiFsue0t7lwtRsg_QPqHl995
# Site key pública do Cloudflare Turnstile (fica no app); a secret key fica somente no Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Opcional: nome do modelo Ollama local usado pela Vex (precisa suportar "tools"). Padrão: qwen2.5:7b.
VITE_OLLAMA_MODEL=qwen2.5:7b
# Só para desenvolvimento local; deixe ausente/false em produção. A Vex online usa Gemini no Supabase.
VITE_VEX_USE_OLLAMA=false
# Chave pública VAPID (Web Push) — não é secreta, gerada uma vez para o projeto. A privada fica só em public.app_secrets no Supabase.
VITE_VAPID_PUBLIC_KEY=BElzs_-XOXaY_VzknrkUaZBrAiy7eEKNadEuoT8DoNYBf9IPhEY4HAq1qT-m072BAk5oRJBv_lLIcRforeg_y08
# Client ID OAuth do Google (Google Cloud Console) — não é secreto, só o Client Secret é (fica em public.app_secrets). Usado pra "Conectar Google Calendar" em /seguranca.
VITE_GOOGLE_CLIENT_ID=
# Chave da API v3 do TMDB (cadastro grátis em themoviedb.org/settings/api) — dado de filme/série é público, sem risco real em expor no cliente. Usado pra busca automática de metadados de filme/série na Biblioteca.
VITE_TMDB_API_KEY=
