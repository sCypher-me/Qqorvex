# Cabeçalhos do Cloudflare Pages para o app web (qqorvex-app.pages.dev).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Arquivos com hash no nome nunca mudam: cache longo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O service worker de notificações precisa sempre da versão mais nova.
/sw.js
  Cache-Control: no-cache
