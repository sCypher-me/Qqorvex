{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qqorvex",
  "version": "0.2.1",
  "identifier": "tech.biocypher.qqorvex",
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["qqorvex"],
          "appLink": false
        },
        {
          "scheme": ["https"],
          "host": "qqorvex-app.pages.dev",
          "pathPrefix": ["/aceitar-convite", "/login"],
          "appLink": true
        }
      ]
    }
  },
  "build": {
    "frontendDist": "../apps/qqorvex/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm --filter qqorvex dev",
    "beforeBuildCommand": "corepack pnpm --filter qqorvex build && node tools/ensure-android-microphone-permission.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Qqorvex",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "asset:", "customprotocol:"],
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "https://uowipikbumbaprckdvkg.supabase.co",
          "wss://uowipikbumbaprckdvkg.supabase.co",
          "https://challenges.cloudflare.com",
          "https://www.googleapis.com",
          "https://api.themoviedb.org"
        ],
        "font-src": ["'self'", "asset:", "data:"],
        "img-src": ["'self'", "asset:", "blob:", "data:", "https:"],
        "style-src": ["'self'", "asset:", "'unsafe-inline'"],
        "script-src": ["'self'", "asset:", "https://challenges.cloudflare.com"],
        "frame-src": [
          "'self'",
          "https://challenges.cloudflare.com",
          "about:blank",
          "about:srcdoc",
          "https://open.spotify.com",
          "https://www.youtube.com",
          "https://player.vimeo.com",
          "https://www.figma.com",
          "https://codepen.io"
        ],
        "media-src": ["'self'", "blob:", "data:", "https:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'", "asset:", "customprotocol:"],
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:5173",
          "ws://localhost:5173",
          "http://localhost:11434",
          "ws://localhost:11434",
          "https://uowipikbumbaprckdvkg.supabase.co",
          "wss://uowipikbumbaprckdvkg.supabase.co",
          "https://challenges.cloudflare.com",
          "https://www.googleapis.com",
          "https://api.themoviedb.org"
        ],
        "font-src": ["'self'", "asset:", "data:"],
        "img-src": ["'self'", "asset:", "blob:", "data:", "https:"],
        "style-src": ["'self'", "asset:", "'unsafe-inline'"],
        "script-src": ["'self'", "asset:", "https://challenges.cloudflare.com"],
        "frame-src": [
          "'self'",
          "https://challenges.cloudflare.com",
          "about:blank",
          "about:srcdoc",
          "https://open.spotify.com",
          "https://www.youtube.com",
          "https://player.vimeo.com",
          "https://www.figma.com",
          "https://codepen.io"
        ],
        "media-src": ["'self'", "blob:", "data:", "https:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 34,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
